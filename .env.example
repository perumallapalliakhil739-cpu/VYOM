# Neurora Configuration Example
# Copy this file to .env and configure your custom credentials if available.

# NASA FIRMS MAP Key (Optional for basic open feeds, required for custom area API)
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Cache Configuration
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=1800

# Rate limits & User-Agent
USER_AGENT=Neurora-Global-Wildfire-Monitor/1.0 (environmental-research)
